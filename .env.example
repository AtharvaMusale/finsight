# Copy to .env and fill in. .env is gitignored; never commit real values.

# REQUIRED by the SEC fair-access policy: identify yourself with a real contact.
# Format: "<app name> <your email>"
FINSIGHT_SEC_USER_AGENT="FinSight portfolio project you@example.com"

# Requests/second to EDGAR. SEC limit is 10; code hard-caps at 10.
FINSIGHT_SEC_MAX_RPS=5

# Vector store: Pinecone (hosted; free Starter plan is us-east-1 only). Keep the key in .env only.
# PINECONE_API_KEY=
FINSIGHT_PINECONE_INDEX=finsight
FINSIGHT_PINECONE_NAMESPACE=filings
# Hosted embeddings. A monthly token guard stops ingestion before the free quota (5M) is hit.
FINSIGHT_DENSE_MODEL=llama-text-embed-v2
FINSIGHT_DENSE_DIM=1024
FINSIGHT_SPARSE_MODEL=pinecone-sparse-english-v0
FINSIGHT_EMBED_TOKEN_BUDGET=3500000

FINSIGHT_DATA_DIR=data
FINSIGHT_TICKERS=["AAPL","MSFT","NVDA"]
FINSIGHT_FORMS=["10-K","10-Q"]
FINSIGHT_YEARS=3

# Step 2 (LLM): the cheap Anthropic model. Add your key to .env only.
# ANTHROPIC_API_KEY=

# Optional: delegate capabilities to A2A agents (see README). Unset = run in-process.
# FINSIGHT_A2A_RETRIEVAL_URL=http://127.0.0.1:9101
# FINSIGHT_A2A_FACTS_URL=http://127.0.0.1:9102
# FINSIGHT_A2A_VERIFIER_URL=http://127.0.0.1:9103

# Tracing: spans go to <data_dir>/traces (counts and timings only, never prompts or filing text).
# FINSIGHT_TRACING=true

# Optional: also send traces to LangSmith (off by default). Add your own key to .env only.
# Unlike the local trace files this sends CONTENT (prompts, filing passages, answers) unless
# you hide it with the two HIDE flags below.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=finsight
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for the EU region
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
